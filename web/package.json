{
  "name": "idea-commons-web",
  "version": "0.1.0",
  "private": true,
  "description": "Application web Idea Commons — premier incrément vertical IC-07, exécution locale à 0 USD.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prebuild": "npm run lint:design-tokens",
    "start": "next start",
    "test:fingerprint": "node --import tsx scripts/source-fingerprint-contract.mts",
    "test:auth-runtime": "node --import tsx scripts/auth-runtime-contract.mts",
    "test:anonymous-catalog-auth": "node --import tsx scripts/anonymous-catalog-auth-contract.mts",
    "test:cloudflare-preflight": "node --import tsx scripts/cloudflare-preflight-contract.mts",
    "test:public-catalog": "node --import tsx scripts/public-catalog-contract.mts",
    "test:runtime": "node --import tsx scripts/runtime-contract.mts",
    "test:migrations": "node --import tsx scripts/migration-contract.mts",
    "lint:design-tokens": "node scripts/design-token-contract.mjs",
    "test:design-tokens": "node --test scripts/design-token-contract.test.mjs && npm run lint:design-tokens",
    "smoke": "npm run test:runtime && npm run test:fingerprint && npm run test:migrations && npm run test:public-catalog",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "prebuild:vinext": "npm run lint:design-tokens",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "cloudflare:preflight": "node scripts/cloudflare-preflight.mjs --local",
    "cloudflare:readiness": "node scripts/cloudflare-preflight.mjs --pre-upload",
    "cloudflare:post-upload": "node scripts/cloudflare-preflight.mjs --post-upload",
    "preview:dev": "node scripts/cloudflare-preview.mjs",
    "deploy:production": "npm run cloudflare:readiness && npm run build:vinext && vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@neondatabase/auth": "0.5.0-beta",
    "@neondatabase/serverless": "^1.1.0",
    "@tabler/icons-react": "3.46.0",
    "@vinext/cloudflare": "^1.0.0-beta.6",
    "border-beam": "1.3.0",
    "next": "^16.3.2",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-server-dom-webpack": "^19.2.8",
    "three": "0.185.1",
    "vinext": "^1.0.0-beta.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.0",
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitejs/plugin-rsc": "^0.5.34",
    "dialkit": "1.4.3",
    "motion": "13.1.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "wrangler": "^4.126.0"
  }
}
