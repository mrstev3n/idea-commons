{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idea-commons.example/schemas/discovery-leads/1.0.0",
  "title": "IdeaCommonsDiscoveryLeads",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "notice", "entries"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "notice": {"type": "string", "minLength": 1},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "submittedUrl", "kind", "priority", "qualification", "catalogueId", "notes"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "label": {"type": "string", "minLength": 1},
          "submittedUrl": {"type": ["string", "null"]},
          "kind": {"enum": ["media", "platform", "community", "thread", "search"]},
          "priority": {"const": "user_priority"},
          "qualification": {"enum": ["qualified_catalogue", "unqualified_lead"]},
          "catalogueId": {"type": ["string", "null"]},
          "notes": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
