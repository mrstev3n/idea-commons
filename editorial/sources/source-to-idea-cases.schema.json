{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idea-commons.example/schemas/source-to-idea-cases/1.0.0",
  "title": "IdeaCommonsSourceToIdeaCases",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "createdAt", "notice", "provenanceDisplayContract", "cases"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "createdAt": {"type": "string", "format": "date"},
    "notice": {"type": "string", "minLength": 1},
    "provenanceDisplayContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["showOriginBeforeInterpretation", "requiredOriginFields", "derivedSectionLabel", "marketClaimsRequireIndependentCitations"],
      "properties": {
        "showOriginBeforeInterpretation": {"const": true},
        "requiredOriginFields": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"enum": ["sourceLabel", "canonicalUrl", "capturedStatement", "captureDate", "evidenceMode"]}},
        "derivedSectionLabel": {"const": "Analyse et hypothèses Idea Commons"},
        "marketClaimsRequireIndependentCitations": {"const": true}
      }
    },
    "cases": {"type": "array", "minItems": 6, "maxItems": 10, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sourceId", "collectedIdentifier", "fixtureFile", "fixturePointer", "statement", "sourceUrl"],
      "properties": {
        "id": {"type":"string","minLength":1},
        "sourceId": {"type":"string","minLength":1},
        "collectedIdentifier": {"type":"string","minLength":1},
        "fixtureFile": {"type":"string","minLength":1},
        "fixturePointer": {"type":"string","pattern":"^/"},
        "statement": {"type":"string","minLength":1},
        "sourceUrl": {"type":["string","null"]}
      }
    },
    "claim": {
      "type":"object","additionalProperties":false,
      "required":["type","statement","citationIds"],
      "properties": {
        "type":{"enum":["fact","source_observation","hypothesis","estimate","recommendation","validation_question"]},
        "statement":{"type":"string","minLength":1},
        "citationIds":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}}
      }
    },
    "case": {
      "type":"object","additionalProperties":false,
      "required":["id","evidenceMode","rightsBasis","evidence","interpretationAngles","problemOrOpportunity","candidate","claims","editorialReview","simulatorScenario","publicationState"],
      "properties": {
        "id":{"type":"string","pattern":"^[a-z0-9-]+$"},
        "evidenceMode":{"enum":["live_minimized","synthetic","mixed"]},
        "rightsBasis":{"enum":["compatible_license","temporary_analysis"]},
        "evidence":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/evidence"}},
        "interpretationAngles":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["type","statement"],"properties":{"type":{"const":"hypothesis"},"statement":{"type":"string","minLength":1}}}},
        "problemOrOpportunity":{"type":"object","additionalProperties":false,"required":["type","statement"],"properties":{"type":{"const":"hypothesis"},"statement":{"type":"string","minLength":1}}},
        "candidate":{"type":"object","additionalProperties":false,"required":["title","summary","beneficiaries","mechanism","limits","risks","openQuestions"],"properties":{"title":{"type":"string","minLength":1},"summary":{"type":"string","minLength":1},"beneficiaries":{"type":"array","minItems":1,"items":{"type":"string"}},"mechanism":{"type":"array","minItems":1,"items":{"type":"string"}},"limits":{"type":"array","minItems":1,"items":{"type":"string"}},"risks":{"type":"array","minItems":1,"items":{"type":"string"}},"openQuestions":{"type":"array","minItems":1,"items":{"type":"string"}}}},
        "claims":{"type":"array","minItems":4,"items":{"$ref":"#/$defs/claim"}},
        "editorialReview":{"type":"object","additionalProperties":false,"required":["evidenceStrength","userNeedSignal","novelty","feasibility","responsibility","total","outcome","explanation"],"properties":{"evidenceStrength":{"type":"integer","minimum":0,"maximum":5},"userNeedSignal":{"type":"integer","minimum":0,"maximum":5},"novelty":{"type":"integer","minimum":0,"maximum":5},"feasibility":{"type":"integer","minimum":0,"maximum":5},"responsibility":{"type":"integer","minimum":0,"maximum":5},"total":{"type":"integer","minimum":0,"maximum":25},"outcome":{"enum":["human_review","hold","insufficient_evidence"]},"explanation":{"type":"string","minLength":1}}},
        "simulatorScenario":{"const":"success"},
        "publicationState":{"const":"human_review_required"}
      }
    }
  }
}
