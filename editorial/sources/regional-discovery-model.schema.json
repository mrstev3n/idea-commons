{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://idea-commons.example/schemas/regional-discovery-model/1.0.0",
  "type":"object","additionalProperties":false,
  "required":["schemaVersion","status","decisionSource","generalBaseline","premiumHypothesis","crossSourceRecommendation","illustrativeScenarios"],
  "properties":{
    "schemaVersion":{"const":"1.0.0"},"status":{"const":"product_hypothesis"},"decisionSource":{"type":"string"},
    "generalBaseline":{"type":"object","required":["principle","sourceIds"],"properties":{"principle":{"type":"string"},"sourceIds":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}}}},
    "premiumHypothesis":{"type":"object","required":["pricingDecisionMade","valueProposition","configurableFields","candidatePacks"],"properties":{"pricingDecisionMade":{"const":false},"valueProposition":{"type":"string"},"configurableFields":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},"candidatePacks":{"type":"array","items":{"type":"string"}}}},
    "crossSourceRecommendation":{"type":"object","required":["minimumIndependentSignalsForEscalation","singleReportLabel","corroboratedLabel","humanReviewRequired","notAnEmergencyInformationService"],"properties":{"minimumIndependentSignalsForEscalation":{"type":"integer","minimum":2},"singleReportLabel":{"type":"string"},"corroboratedLabel":{"type":"string"},"humanReviewRequired":{"const":true},"notAnEmergencyInformationService":{"const":true}}},
    "illustrativeScenarios":{"type":"array","minItems":3,"items":{"type":"object","required":["id","evidenceClass","event","candidateIdea","warning"],"properties":{"id":{"type":"string"},"evidenceClass":{"const":"user_provided_hypothesis"},"event":{"type":"string"},"candidateIdea":{"type":"string"},"warning":{"type":"string"}}}}
  }
}
